    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.9",
    "@yusr/config": "workspace:*",
    "esbuild": "^0.25.10",
    "typescript": "^6.0.0"
  }
}
