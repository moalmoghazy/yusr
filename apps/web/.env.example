# Where the server-side code reaches the API (never exposed to the browser).
YUSR_API_URL=http://localhost:4000/v1
# Optional, server-only: the same value as the API's YUSR_EDGE_SECRET. With it, the site passes each
# visitor's address to the API (x-yusr-client-ip) so rate limits count people, not this server.
YUSR_EDGE_SECRET=
# The site's public origin: canonical URLs, hreflang alternates, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: product analytics and error tracking (added to the Content-Security-Policy when set).
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
# Regulator line on the home page (set to false until the association's registration is in place),
# and its registration number (رقم الإشهار), shown next to it when set.
NEXT_PUBLIC_SHOW_SUPERVISION=true
NEXT_PUBLIC_MOSS_REGISTRATION_NUMBER=
# Where the browser uploads case documents (the S3 / R2 bucket's origin; its CORS must allow PUT from
# this site). Development defaults to the API's /dev-storage.
UPLOAD_ORIGIN=
# App links: the iOS team ID and the Android signing certificate SHA-256 (comma-separated).
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
