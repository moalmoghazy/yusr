    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.9",
    "@yusr/config": "workspace:*",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0"
