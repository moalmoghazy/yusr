{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_API_URL": "https://api.yusr.org/v1", "EXPO_PUBLIC_WEB_URL": "https://yusr.org" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://api.yusr.org/v1", "EXPO_PUBLIC_WEB_URL": "https://yusr.org" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://api.yusr.org/v1", "EXPO_PUBLIC_WEB_URL": "https://yusr.org" }
    }
  },
  "submit": {
    "production": {}
  }
}
