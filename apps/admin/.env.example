# Server-side API base URL (sessions are exchanged here; the browser never sees tokens).
YUSR_API_URL=http://localhost:4000/v1
# Optional, server-only: the same value as the API's YUSR_EDGE_SECRET. With it, the hub passes each
# visitor's address to the API (x-yusr-client-ip) so sign-in rate limits count people, not this server.
YUSR_EDGE_SECRET=
