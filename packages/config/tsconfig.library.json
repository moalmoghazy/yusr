{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true,
    // tsup's declaration build sets `baseUrl`, which TypeScript 6 deprecates (it still works until 7.0).
    // Remove this line once tsup stops setting it, or when the packages move to another bundler.
    "ignoreDeprecations": "6.0"
  }
}
