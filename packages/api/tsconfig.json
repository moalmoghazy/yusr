{
  "extends": "@yusr/config/tsconfig.base.json",
  "compilerOptions": {
    // CommonJS output for NestJS; "bundler" resolution reads the workspace packages'
    // exports (including the @yusr/source condition) and their extensionless imports.
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    "incremental": true
  },
  "include": ["src", "test", "scripts", "drizzle.config.ts"]
}
