# ---- Runtime
NODE_ENV=development
PORT=4000
# Build identifier shown by /health and sent to Sentry (CI sets it to the git SHA).
YUSR_RELEASE=dev
# Which proxies may set X-Forwarded-For. Rate limits count per client IP, so set this to your load balancer (e.g. 1 hop).
TRUST_PROXY=loopback, linklocal, uniquelocal
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# memory = run without PostgreSQL/Redis (demo data, simulated gateways)
YUSR_STORAGE=postgres
# The built-in development secrets are refused in production and whenever DATABASE_URL is not on this
# machine. true accepts them anyway on a non-local database (a throwaway staging stack only; never production).
YUSR_ALLOW_DEV_SECRETS=false
# Shared secret of the website and control hub servers (same value in their settings). With it they pass
# the visitor's IP (x-yusr-client-ip) so rate limits count visitors, not the Next.js server. Empty: ignored.
YUSR_EDGE_SECRET=
# The outbox worker runs inside the API unless this is false (then run `pnpm worker` separately).
RUN_WORKER=true

# ---- Data
DATABASE_URL=postgres://yusr:yusr@localhost:5432/yusr
REDIS_URL=redis://localhost:6379

# ---- Auth
JWT_SECRET=change-me-to-64-random-bytes
# During a rotation: the old secret, still accepted for one access-token lifetime.
JWT_SECRET_PREVIOUS=
JWT_ISSUER=https://api.yusr.example
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_PEPPER=change-me
# Countries that may receive sign-in codes (calling codes; others are refused against SMS pumping).
YUSR_OTP_COUNTRY_CODES=20,966
# Sign-in codes the whole platform may send per hour.
YUSR_OTP_HOURLY_BUDGET=1000
NATIONAL_ID_PEPPER=change-me
RECEIPT_TOKEN_SECRET=change-me
GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,ios-client-id.apps.googleusercontent.com
APPLE_CLIENT_IDS=example.yusr.app,example.yusr.web

# ---- Payments (sandbox credentials)
# simulated = the built-in test gateway (development); live = the providers configured below.
PAYMENTS_MODE=simulated
SIMULATOR_SECRET=change-me
# Optional FX rates feed for cross-currency gifts (JSON); fixed demo rates when empty.
FX_FEED_URL=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_CARD=
PAYMOB_INTEGRATION_WALLET=
PAYMOB_INTEGRATION_APPLE_PAY=
FAWRY_BASE_URL=https://atfawry.fawrystaging.com
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_TOKEN=
INSTAPAY_IPA=yusr@instapay
INSTAPAY_ACCOUNT_NAME=Yusr Foundation

# ---- Files (Cloudflare R2 / S3)
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=yusr-documents
S3_PUBLIC_BUCKET=yusr-public
# CDN or public URL in front of the public bucket (redacted documents, covers).
S3_PUBLIC_BASE_URL=https://files.yusr.example
DATA_KEY_BASE64=

# ---- Messaging & operations
# Production needs SMS_* or WHATSAPP_* for sign-in codes (codes go by SMS when both are set).
# Free tests (Resend free tier, the WhatsApp Cloud API test number): docs/GUIDE.ar.md, section 5.12.
# On demo data the messages are still listed in the hub («الرسائل المرسلة»); sign-in codes stay on screen.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
EMAIL_API_KEY=
EMAIL_FROM=Yusr <receipts@yusr.example>
EXPO_ACCESS_TOKEN=
SLACK_FIELD_OPS_WEBHOOK=
SLACK_FINANCE_WEBHOOK=
BASEROW_URL=https://api.baserow.io
BASEROW_TOKEN=
BASEROW_VISITS_TABLE_ID=
CHATWOOT_HMAC_TOKEN=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
