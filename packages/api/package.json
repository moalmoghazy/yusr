{
  "name": "@yusr/api",
  "version": "0.1.0",
  "private": true,
  "description": "Yusr REST API: NestJS 11 on PostgreSQL 16 (Drizzle) and Redis. Donations and payments (Paymob, Fawry, Stripe, Moyasar, InstaPay), double-entry ledger, case pipeline, maker-checker payouts, RBAC and audit.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --conditions=@yusr/source --import tsx --watch src/main.ts",
    "dev:memory": "YUSR_STORAGE=memory node --env-file-if-exists=.env --conditions=@yusr/source --import tsx --watch src/main.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "worker": "node dist/notifications/worker.main.js",
    "worker:dev": "node --env-file-if-exists=.env --conditions=@yusr/source --import tsx src/notifications/worker.main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=@yusr/source --import tsx --test test/*.test.ts",
    "test:e2e": "node --conditions=@yusr/source --import tsx --test test/http.test.ts",
    "test:sql": "node --conditions=@yusr/source --import tsx --test test/sql.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --conditions=@yusr/source --import tsx src/db/migrate.ts",
    "db:migrate:deploy": "node dist/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env --conditions=@yusr/source --import tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "staff:create": "node --env-file-if-exists=.env --conditions=@yusr/source --import tsx src/db/create-staff.ts",
    "openapi": "node --conditions=@yusr/source --import tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.899.0",
    "@aws-sdk/s3-request-presigner": "^3.899.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@sentry/nestjs": "^10.17.0",
    "@yusr/core": "workspace:*",
    "@yusr/i18n": "workspace:*",
    "@yusr/sdk": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "pg": "^8.16.3",
    "posthog-node": "^5.9.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@yusr/config": "workspace:*",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0"
  }
}
