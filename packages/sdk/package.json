{
  "name": "@yusr/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the Yusr API plus an in-memory demo backend (same contract) for prototypes, previews and tests.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@yusr/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./mock": {
      "@yusr/source": "./src/mock/index.ts",
      "import": {
        "types": "./dist/mock/index.d.ts",
        "default": "./dist/mock/index.js"
      },
      "require": {
        "types": "./dist/mock/index.d.cts",
        "default": "./dist/mock/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=@yusr/source --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@yusr/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@yusr/config": "workspace:*",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0"
  }
}
